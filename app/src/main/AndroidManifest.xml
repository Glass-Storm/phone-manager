<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISSION MATRIX — the hub's exact needs, by API level.

      The app targets API 29, so several entries are the API<33 branch of a
      runtime-branched requirement (see permission/hub_permissions.kt). Each
      comment names WHICH API level consults it, so nothing here is speculative.

      INTERNET (all APIs) — the hub binds and accepts sockets. On Android one
        permission covers both bind and connect.
      FOREGROUND_SERVICE (all APIs) — hosts the long-lived listener.
      FOREGROUND_SERVICE_CONNECTED_DEVICE (API 34+ enforces the type) — the type
        this service declares is `connectedDevice`.
      POST_NOTIFICATIONS (API 33+) — required to post the FGS notification from
        API 33; granted at install below 33.
      ACCESS_WIFI_STATE (all APIs) — reading Wi-Fi state; LocalOnlyHotspot and the
        multicast lock are Wi-Fi-manager operations.
      CHANGE_WIFI_STATE (all APIs) — starting/stopping the LocalOnlyHotspot
        reservation modifies Wi-Fi state.
      CHANGE_WIFI_MULTICAST_STATE (API<33, and API 33 until T-ext 7) — required to
        acquire the Wi-Fi MulticastLock that keeps mDNS frames flowing; the T9
        adapter acquires it exactly when the platform needs it.
      ACCESS_NETWORK_STATE (all APIs) — network reachability/connectivity checks
        the hub performs while bringing peers up.
      ACCESS_FINE_LOCATION (API<33 — the ACTIVE path here at targetSdk 29) —
        LocalOnlyHotspot is gated on this runtime grant, and location services
        must also be enabled.
      NEARBY_WIFI_DEVICES (API>=33 only) — replaces the location gate for Wi-Fi
        APIs on API 33+ with a 33+ target; declared neverForLocation so it can
        never be treated as location access.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      API 33+ only: the Wi-Fi permission that replaces ACCESS_FINE_LOCATION for
      LocalOnlyHotspot/NSD. `neverForLocation` asserts the app does not derive
      physical location from this data.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      NOT declared, deliberately:
        * REQUEST_IGNORE_BATTERY_OPTIMIZATIONS — the exemption helper builds the
          ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS intent (battery/
          battery_optimization.kt), but the plan forbids permissions no shipped
          code path reads, and the direct-request launch is surfaced by T17's
          Settings screen. Declaring it is a one-line change if that path ever
          needs a platform guarantee; the helper documents this gap explicitly.

      DEV-ONLY cleartext: `usesCleartextTraffic` + the network security config are
      development posture for the local-only LAN. Raw sockets (the netty gRPC
      listener) are NOT subject to this policy — only HTTP-client stacks are — so
      it must never be presented as the hub's security boundary. See
      res/xml/network_security_config.xml for the full rationale and the TLS
      upgrade path.
    -->
    <application
        android:name=".PhoneManagerApplication"
        android:label="Phone Manager"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A started foreground service hosting the gRPC hub. Not exported: only
             this app may start its own hub. `connectedDevice` matches the type the
             hub actually provides (a LAN peer connection). -->
        <service
            android:name=".HubForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
