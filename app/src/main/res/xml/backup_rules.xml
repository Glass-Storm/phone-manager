<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud-backup exclusions (Android 11 and below; from API 31 the platform also
  reads data_extraction_rules.xml).

  WHAT IS EXCLUDED AND WHY
  ========================
  * `runtime_config.xml` is the app-private runtime config store (the hotspot mode;
    see the adapter's RuntimeConfigStore, prefs file "runtime_config"). It is
    device-local operational state, so it is kept out of a cloud/device-transfer
    snapshot.
  * `phone_manager.db` is the SQLite device store; it holds device-bound security
    state and is excluded from backup AND from device transfer.

  The hub stores no cloud credentials: it runs a single on-device speech engine
  with no third-party STT/TTS cloud path.

  EXCLUSIONS, NOT INCLUSIONS
  ==========================
  Everything else remains eligible for backup. The exclusions below are the
  security-relevant subset only.

  XML NOTE: an XML comment may not contain a double hyphen run, so the separators
  above use `=`.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="runtime_config.xml" />
    <exclude domain="database" path="phone_manager.db" />
</full-backup-content>
