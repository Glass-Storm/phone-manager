# ktlint configuration for phone-manager.
#
# The repo follows the standard Kotlin naming convention, as documented in
# README.md under "Repo conventions" -> "Naming": PascalCase `ClassName.kt`
# files, lowerCamelCase functions and properties, and UPPER_SNAKE_CASE
# `const val`s. ktlint's default naming rules already assume this convention,
# so they are ENABLED here and genuinely enforced — nothing is disabled.
#
# Every code-correctness rule (indentation, unused/wildcard imports, import
# ordering, final newline, blank lines, spacing, wrapping, …) is likewise
# ENABLED. No baseline file is used.
#
# The rule ids are the ktlint 1.5.0 standard-rule ids — the version
# ktlint-gradle 14.2.0 pulls (verified with
# `./gradlew :domain:dependencies --configuration ktlint`), so any keys below
# resolve against the real ruleset.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# No rule is disabled: the Kotlin naming convention IS the ktlint default
# (PascalCase files, lowerCamelCase members, UPPER_SNAKE_CASE constants), so
# the standard naming rules run unmodified and fail the build on violation.
#
# The one rule parameter is the documented Compose carve-out. Compose names a
# function that emits UI in PascalCase (it is treated like a factory/type), which
# is the opposite of the camelCase a plain function takes; ktlint's own guidance
# is to exempt `@Composable` functions from function-naming rather than lowercase
# them. The rule stays ENABLED — it still enforces camelCase on every other
# function, and only skips functions annotated `@Composable`.
ktlint_function_naming_ignore_when_annotated_with = Composable
